	assert_int(ordered[2].state).override_failure_message(
		"deletion probe: with the villager's own scaffold awareness severed, the top course" +
		" must reproduce the pre-change failure (never BUILT) -- a green suite that stays" +
		" green with production scaffold-awareness removed is vacuous"
	).is_not_equal(BlueprintCell.MicroState.BUILT)
