	# clears the top cell's occupancy (body_column(occupant) always reaches
	# `occupant.y + 2`); a DIFFERENT column entirely (an ordinary horizontal
	# step, never a same-column one) is what SC-INV-1 actually requires here,
	# exactly the ground-floor staging cell the worker approached from.
	var ground_cell: Vector3i = owner_cell + Vector3i(2, 0, 0)
	villager.current_cell = ground_cell
	villager._from_cell = ground_cell
	villager._to_cell = ground_cell

	var fully_dismantled: bool = false
	for _i in range(50):
		TimeTickSystem.tick.emit()
		if scaffold_registry.is_empty():
			fully_dismantled = true
			break
	assert_bool(fully_dismantled).override_failure_message(
		"AC3: both paths must terminate with ZERO scaffold cells remaining"
	).is_true()
	assert_bool(dismantle_coordinator.is_dismantling(owner_project.id)).override_failure_message(
		"the dismantle orchestrator must clear its own latch once the structure fully empties"
	).is_false()


