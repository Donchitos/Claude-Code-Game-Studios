func test_lever3_deletion_probe_unwired_scaffold_registry_reproduces_the_prechange_failure() -> void:
	var valley: Valley = _setup_click_fixture()
	valley.get_build_editor_mode().arm_tool(ToolStateMachine.TOOL_ID_WALL)
	_fire_click(valley.get_placement_pick())
	var ordered: Array[BlueprintCell] = _ordered_by_y(valley.get_commit_pipeline().get_blueprint_cells())
	var base_cell: Vector3i = ordered[0].cell

	var registry: BuildProjectRegistry = valley.get_build_project_registry()
	registry.release_project(registry.project_at_cell(base_cell))

	var villager: VillagerAi = valley.get_villager_ai()
	var staging_cell: Vector3i = base_cell + Vector3i(1, 0, 0)
	villager.current_cell = staging_cell
	villager._from_cell = staging_cell
	villager._to_cell = staging_cell

	# The deletion probe: simulate "the scaffold-erection call site never
	# ran" by severing the SAME injection this story's own Valley wiring
	# performs -- a scaffold-blind villager reproduces exactly the pre-change
	# defect, even though ScaffoldRegistry/ScaffoldErectionCoordinator are
	# still fully constructed and hosted underneath it.
	villager.scaffold_registry = null

	for _i in range(600):
