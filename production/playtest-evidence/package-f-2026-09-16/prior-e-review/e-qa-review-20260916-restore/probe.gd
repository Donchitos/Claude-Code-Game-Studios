extends SceneTree
const Arena = preload("res://src/campaign/campaign_arena.gd")
const Codec = preload("res://src/campaign/campaign_arena_codec.gd")
const Profile = preload("res://src/campaign/campaign_profile.gd")
const Storage = preload("res://src/persistence/save_system.gd")
func _initialize():
	_run.call_deferred()
func _run():
	var c = load("res://src/campaign/campaign_catalog.gd").load_catalog()
	var storage = Storage.new()
	assert(storage.initialize("/tmp/e-qa-review-20260916-restore/slota", "/tmp/e-qa-review-20260916-restore/slotb") == 0)
	var p = Profile.new()
	assert(p.initialize(c, storage))
	assert(p.begin_run(0).status == "OK")
	var run = p.data.current_run
	var a = Arena.new()
	root.add_child(a)
	assert(a.configure(c,c.missions[0],run.loadout,str(run.seed).to_int()))
	a.state.player.xp = 100
	a.advance(1.0/60,Vector2.ZERO)
	assert(a.choose_upgrade(a.state.offered[0]))
	var clean = a.snapshot()
	var bad = clean.duplicate(true)
	bad.state.encounter.last_upgrade_tick = -1
	bad.numeric_bits = Codec.bits(bad.state)
	print("BEFORE tick=",a.state.tick," level=",a.state.player.level," last=",a.state.encounter.last_upgrade_tick," offered=",a.state.offered)
	print("BAD_SENTINEL valid=",Arena.validate_snapshot(c,c.missions[0],bad)," saved=",p.save_run(bad)," err=",p.error)
	storage.free()
	storage = Storage.new()
	assert(storage.initialize("/tmp/e-qa-review-20260916-restore/slota", "/tmp/e-qa-review-20260916-restore/slotb") == 0)
	p = Profile.new()
	assert(p.initialize(c,storage))
	run = p.data.current_run
	var b = Arena.new()
	root.add_child(b)
	assert(b.configure(c,c.missions[0],run.loadout,str(run.seed).to_int(),run.snapshot))
	a.advance(1.0/60,Vector2.ZERO)
	b.advance(1.0/60,Vector2.ZERO)
	print("CLEAN tick=",a.state.tick," level=",a.state.player.level," offered=",a.state.offered)
	print("RESTORED tick=",b.state.tick," level=",b.state.player.level," offered=",b.state.offered)
	a.free()
	b.free()
	storage.free()
	quit()
