extends GdUnitTestSuite

func test_game_root_owns_root_viewport_gate_and_battle_ui_canvas_route() -> void:
	var runner := scene_runner("res://main.tscn")
	await await_idle_frame()
	var game_root: GameRootSlice = runner.scene()
	assert_object(game_root).is_not_null()
	assert_object(game_root.root_viewport).is_equal(game_root.get_viewport())
	assert_bool(game_root.viewport_gate_held).is_false()
	assert_bool(game_root.root_viewport.gui_disable_input).is_false()
	assert_object(game_root.battle_ui_layer).is_instanceof(CanvasLayer)
	assert_object(game_root.battle_ui.get_parent()).is_equal(game_root.battle_ui_layer)
	assert_int(game_root.battle_ui_layer.layer).is_equal(10)

func test_gate_held_blocks_touch_until_activation_success_release() -> void:
	var runner := scene_runner("res://main.tscn")
	await await_idle_frame()
	var game_root: GameRootSlice = runner.scene()
	assert_int(game_root.acquire_viewport_input_gate()).is_equal(0)
	assert_bool(game_root.root_viewport.gui_disable_input).is_true()
	runner.simulate_screen_touch_press(23, Vector2(90.0, 450.0))
	await await_idle_frame()
	assert_bool(game_root.host.claim_active).is_false()
	assert_int(game_root.release_viewport_input_gate(&"NOT_ACTIVATION_SUCCESS")).is_equal(5)
	assert_bool(game_root.viewport_gate_held).is_true()
	assert_int(game_root.release_viewport_input_gate(&"ACTIVATION_SUCCESS")).is_equal(0)
	assert_bool(game_root.root_viewport.gui_disable_input).is_false()
	runner.simulate_screen_touch_press(24, Vector2(90.0, 450.0))
	await await_idle_frame()
	assert_bool(game_root.host.claim_active).is_true()
	runner.simulate_screen_touch_release(24)
	await await_idle_frame()
	assert_bool(game_root.host.claim_active).is_false()

func test_battle_scope_replacement_preserves_game_root_and_viewport_identity() -> void:
	var runner := scene_runner("res://main.tscn")
	await await_idle_frame()
	var game_root: GameRootSlice = runner.scene()
	var root_id := game_root.get_instance_id()
	var viewport_id := game_root.root_viewport.get_instance_id()
	var old_scope := game_root.battle_scope
	var old_generation := game_root.battle_scope_generation
	assert_int(game_root.pause_battle_scope()).is_equal(0)
	assert_int(game_root.input_system.state).is_equal(InputSystem.State.RESUME_LOCKED)
	assert_int(game_root.resume_battle_scope()).is_equal(0)
	assert_int(game_root.replace_battle_scope()).is_equal(0)
	assert_bool(old_scope.is_inside_tree()).is_false()
	await await_idle_frame()
	assert_int(game_root.get_instance_id()).is_equal(root_id)
	assert_int(game_root.root_viewport.get_instance_id()).is_equal(viewport_id)
	assert_bool(is_instance_valid(old_scope)).is_false()
	assert_int(game_root.battle_scope_generation).is_equal(old_generation + 1)
	assert_int(game_root.input_system.state).is_equal(InputSystem.State.ACTIVE)
	assert_int(game_root.host.registered_active_vj_count()).is_equal(1)
	assert_bool(game_root.viewport_gate_held).is_false()
	assert_int(game_root.replace_battle_scope()).is_equal(0)
	assert_int(game_root.battle_scope_generation).is_equal(old_generation + 2)
	assert_int(game_root.host.registered_active_vj_count()).is_equal(1)
	await await_idle_frame()

func test_teardown_detaches_battle_scope_and_keeps_gate_held() -> void:
	var runner := scene_runner("res://main.tscn")
	await await_idle_frame()
	var game_root: GameRootSlice = runner.scene()
	var old_scope := game_root.battle_scope
	assert_int(game_root.teardown_battle_scope()).is_equal(0)
	assert_bool(old_scope.is_inside_tree()).is_false()
	assert_object(game_root.battle_scope).is_null()
	assert_object(game_root.input_system).is_null()
	assert_object(game_root.host).is_null()
	assert_bool(game_root.viewport_gate_held).is_true()
	assert_bool(game_root.root_viewport.gui_disable_input).is_true()
	await await_idle_frame()
