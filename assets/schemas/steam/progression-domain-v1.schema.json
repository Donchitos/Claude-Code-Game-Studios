    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$(?![\\s\\S])"
    },
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$(?![\\s\\S])"
    },
    "bits64": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$(?![\\s\\S])"
    },
    "f64": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$(?![\\s\\S])",
      "format": "steam-f64"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[\\x01-\\x7f]+$(?![\\s\\S])"
    },
