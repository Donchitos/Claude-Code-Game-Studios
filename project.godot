"events": []
}
ui_focus_right={
"deadzone": 0.0,
"events": []
}
ui_activate={
"deadzone": 0.0,
"events": []
}
ui_back={
"deadzone": 0.0,
"events": []
}
ui_increment={
"deadzone": 0.0,
"events": []
}
ui_decrement={
"deadzone": 0.0,
"events": []
}

touch_move_left={
"deadzone": 0.0,
"events": []
}
touch_move_right={
"deadzone": 0.0,
"events": []
}
touch_move_up={
"deadzone": 0.0,
