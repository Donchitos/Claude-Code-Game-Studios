; Root production Godot project. Nested prototype and harness projects are isolated
; with .gdignore files and are not part of this runtime.

config_version=5

[application]

config/name="掌天试炼"
run/main_scene="res://src/core/GameRoot.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/branding/app_icon.svg"
boot_splash/fullsize=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/resizable=true

[input]

ui_focus_next={
"deadzone": 0.0,
"events": []
}
ui_focus_previous={
"deadzone": 0.0,
"events": []
}
