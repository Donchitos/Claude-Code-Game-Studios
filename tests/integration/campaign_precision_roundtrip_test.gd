extends SceneTree
## Promoted from the independent chapter-two review regression probe.
const Arena=preload("res://src/campaign/campaign_arena.gd")
const Profile=preload("res://src/campaign/campaign_profile.gd")
const Storage=preload("res://src/persistence/save_system.gd")
func _initialize(): _run.call_deferred()
func _run():
	var c=load("res://src/campaign/campaign_catalog.gd").load_catalog()
	var stem="/tmp/ch2-profile-roundtrip-%s-"%OS.get_process_id()
	var s=Storage.new()
	assert(s.initialize(stem+"a",stem+"b")==0)
	var p=Profile.new()
	assert(p.initialize(c,s))
	assert(p.begin_run(0).status=="OK")
	var a=Arena.new()
	root.add_child(a)
	var run=p.data.current_run
	assert(a.configure(c,c.missions[0],run.loadout,str(run.seed).to_int()))
	for i in 300: a.advance(1.0/60,Vector2(0.3,0.7))
	var snap=a.snapshot()
	assert(p.save_run(snap))
	for i in 20:
		s.free()
		s=Storage.new()
		assert(s.initialize(stem+"a",stem+"b")==0)
		p=Profile.new()
		assert(p.initialize(c,s))
		assert(p.update_settings({"music":0.5 if i%2 else 0.75}))
		run=p.data.current_run
		assert(a.configure(c,c.missions[0],run.loadout,str(run.seed).to_int(),run.snapshot))
		assert(a.snapshot()==snap)
	var stale=Profile.new()
	assert(stale.initialize(c,s))
	assert(p.update_settings({"music":0.9}))
	assert(not stale.update_settings({"music":0.8}) and stale.error=="STALE_PROFILE_RELOAD_REQUIRED")
	a.free();s.free()
	assert(DirAccess.remove_absolute(stem+"a")==OK)
	assert(DirAccess.remove_absolute(stem+"b")==OK)
	print("PROFILE_20_RELOAD_SETTINGS_SNAPSHOT_EXACT_AND_STALE_REJECT_PASS")
	quit()
